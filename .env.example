# ---- database ----
DATABASE_URL=postgres://theo:CHANGE_ME@localhost:5432/theodesmond
# Used only by docker-compose for the bundled Postgres (app uses DATABASE_URL above).
DB_PASSWORD=CHANGE_ME

# ---- server ----
PORT=3001
SITE_URL=https://theodesmond.com

# ---- first staff account (created automatically on first boot if empty) ----
ADMIN_EMAIL=iamtheo@theodesmond.com
ADMIN_PASSWORD=CHANGE_ME_AFTER_FIRST_LOGIN
JWT_SECRET=generate-a-long-random-string

# ---- email (Brevo SMTP relay, same values as before) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM_EMAIL=no-reply@theodesmond.com
CONTACT_TO_EMAIL=hello@theodesmond.com
VISIT_TO_EMAIL=hello@theodesmond.com

# ---- Aurex chat (calls INTO the standalone aurex-saas-model backend) ----
AUREX_API=http://localhost:4010
AUREX_SERVICE_EMAIL=theodesmond-svc@theodesmond.com
AUREX_SERVICE_PASS=
AUREX_PROJECT_ID=

# ---- frontend (optional) ----
# Same-origin by default. Only set this for `npm run dev` against a remote API.
# VITE_API_BASE=
