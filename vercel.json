{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|avif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff|woff2|ttf|otf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.theodesmond.com" }],
      "destination": "https://theodesmond.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.theodesmond.com" }],
      "destination": "https://theodesmond.com/:path*",
      "permanent": true
    },
    { "source": "/about.php", "destination": "/about", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/pricing", "destination": "/portfolio", "permanent": true },
    { "source": "/pricing.php", "destination": "/portfolio", "permanent": true },
    { "source": "/products", "destination": "/portfolio", "permanent": true },
    { "source": "/work.php", "destination": "/portfolio", "permanent": true },
    { "source": "/contact.php", "destination": "/contact", "permanent": true },
    { "source": "/blog.php", "destination": "/blog", "permanent": true },
    { "source": "/dist/:path*/", "destination": "/404.html", "statusCode": 404 },
    { "source": "/src/:path*/", "destination": "/404.html", "statusCode": 404 },
    { "source": "/node_modules/:path*/", "destination": "/404.html", "statusCode": 404 }
  ]
}